model Frequency {
  id          Int        @id
  name        String
  /// The actual frequenz per year, e.g. name=monthly -> value=12
  value       Int
  isRecurring Boolean
  incomes     Income[]
  contracts   Contract[]
}

enum FileStatusChoice {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum PipelineMode {
  DOCUMENT_AI
  SEPARATED
}

// Singleton (always operated on at id: 1 via upsert) holding the AI/OCR provider config used by
// the document → OCR → auto-added-expense pipeline (Phase 8c/8d). Kept provider-generic (host +
// model + key). NOTE: apiKey is stored plaintext — acceptable for a personal local app; it is only
// ever read server-side (see features/settings/db/aiSettings.ts), never sent to the client.
model AiSettings {
  id           Int          @id @default(autoincrement())
  enabled      Boolean      @default(false)
  apiKey       String       @default("")
  baseUrl      String?
  ocrModel     String       @default("mistral-ocr-latest")
  extractModel String       @default("mistral-small-latest")
  pipelineMode PipelineMode @default(DOCUMENT_AI)
  updatedAt    DateTime     @updatedAt
}

// Singleton (always operated on at id: 1 via upsert) holding the Home Assistant MQTT bridge config
// (Phase 17). Kept in the DB rather than env vars so enabling the bridge never requires editing
// /opt/beyondledger/.env or the two deploy scripts — an existing install picks the feature up from
// the plain `git pull && migrate deploy && build` the update script already runs. NOTE: password is
// stored plaintext — same tradeoff as AiSettings.apiKey; it is only ever read server-side (see
// features/integrations/db/mqttSettings.ts), never sent to the client.
model MqttSettings {
  id                     Int      @id @default(autoincrement())
  enabled                Boolean  @default(false)
  host                   String   @default("")
  port                   Int      @default(1883)
  useTls                 Boolean  @default(false)
  username               String   @default("")
  password               String   @default("")
  clientId               String   @default("beyondledger")
  topicPrefix            String   @default("beyondledger")
  discoveryPrefix        String   @default("homeassistant")
  /// ISO currency code (not a symbol) — Home Assistant's statistics machinery keys on this string.
  currency               String   @default("EUR")
  /// Optional http://host:port of this app, published as the HA device's configuration_url.
  appUrl                 String   @default("")
  publishIntervalSeconds Int      @default(300)
  updatedAt              DateTime @updatedAt
}

// Singleton (always operated on at id: 1 via upsert) holding app-wide user preferences that must
// reach Server Components — currently the UI/formatting locale ("en" | "de"). Unlike the theme
// (client-side via next-themes), locale drives server-rendered output (<html lang>, currency/date
// formatting, translated strings) so it is persisted in the DB and read server-side.
model AppSettings {
  id                 Int      @id @default(autoincrement())
  locale             String   @default("en")
  // The account (Workspace) the app is currently filtered to (Phase 14). null = "All accounts" (no
  // filter). Plain nullable Int rather than a relation so deleting the active workspace can't be
  // blocked by an FK on the settings singleton — a stale id simply reads back as "All".
  activeWorkspaceId  Int?
  // Dashboard reminder windows (Phase 12). warrantyWarnDays drives the "warranties about to expire"
  // alert (item purchase date + warranty months, within N days). upcomingWindowDays drives the
  // dashboard's upcoming fixed-expense/income lists. Kept separate so each can be tuned on its own.
  warrantyWarnDays   Int      @default(60)
  upcomingWindowDays Int      @default(30)
  // How many preceding periods every rolling baseline averages over, per chart granularity: the Ø
  // line on each chart and the dashboard KPI comparison both read these. Separate per unit because
  // "the last 8 weeks" and "the last 8 years" are wildly different asks of the data. Note these are
  // only ceilings — the average never counts a period older than the earliest record (see
  // features/expense/shared/db/dataHorizon.ts), so a fresh install is not diluted by empty periods.
  lookbackWeeks      Int      @default(8)
  lookbackMonths     Int      @default(6)
  lookbackYears      Int      @default(3)
  updatedAt          DateTime @updatedAt
}

model FileAsset {
  id           Int              @id @default(autoincrement())
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  relativePath String
  status       FileStatusChoice
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  billId Int?
  bill   Bill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([billId, contractId, createdAt(sort: Desc)])
}

// A Workspace is a bank account (Phase 14): the user's personal account, their partner's, and a
// shared/joint account. Every top-level financial record (Bill/Contract/Income/Budget) is paid from
// exactly one account (required workspaceId FK). Modeled as user-managed reference data like Tag —
// name is unique (enforced case-insensitively in code), color is a palette hex with a default. The
// FKs on the records are RESTRICT (Prisma default) so an account still holding records can't be
// deleted from Settings.
model Workspace {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())

  bills     Bill[]
  contracts Contract[]
  incomes   Income[]
  budgets   Budget[]
}

// A free-form, colored label attached to entries (Bill/Contract/Income) for cross-cutting
// classification independent of category (e.g. "gift", "Steuererklärung", "vacation"). name is
// unique (enforced case-insensitively in code, like IncomeCategory); color is a user-picked hex
// string with a default applied at create time.
model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String
  createdAt DateTime   @default(now())

  entries       EntryTag[]
  budgetMembers BudgetMember[]
}

// Polymorphic tag assignment: exactly ONE of billId/itemId/contractId/incomeId is set per row (mirrors
// the BudgetMember convention — the repo has no implicit Prisma m-n). Items are tagged in addition to
// their parent Bill so a cross-cutting tag (e.g. "gift") can land on a single line item regardless of
// the bill's other contents. The entry FKs cascade so deleting a Bill/Item/Contract/Income drops its
// assignments; the tag FK is left RESTRICT (Prisma's default) so a tag that's still in use can't be
// deleted from Settings — matching every other lookup there.
model EntryTag {
  id    Int @id @default(autoincrement())
  tag   Tag @relation(fields: [tagId], references: [id])
  tagId Int

  bill       Bill?     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId     Int?
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId Int?
  income     Income?   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  incomeId   Int?

  @@unique([tagId, billId])
  @@unique([tagId, itemId])
  @@unique([tagId, contractId])
  @@unique([tagId, incomeId])
  @@index([billId])
  @@index([itemId])
  @@index([contractId])
  @@index([incomeId])
}
