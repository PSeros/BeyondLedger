# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Intellij Ides'
.idea

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# uploaded document storage
/storage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client — `prisma generate` rewrites it on every install, dev run and deploy, so
# committing it means the production checkout is permanently dirty and `git pull --ff-only` aborts
# as soon as a pushed commit touches the same files. (This entry used to name the old output path.)
/prisma/generated

# claude code / agent tooling
.claude/
.agents/
skills-lock.json
# Local prototype/scratch databases
/prisma/*.db
/prisma/*.db-journal
